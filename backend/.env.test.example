# 隔离数据库集成测试模板。复制为 .env.test 后填写本机测试资源。
NODE_ENV=test

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=erp_test
DB_USER=root
DB_PASSWORD=replace_with_test_database_password

# 默认拒绝初始化和集成测试；仅在确认连接的是隔离测试库后临时修改。
ALLOW_TEST_DB_INIT=NO
RUN_DB_TESTS=0

# 若后续增加真实 Redis 集成测试，只允许独立 DB 编号和测试前缀。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=15
REDIS_KEY_PREFIX=erp:test:
