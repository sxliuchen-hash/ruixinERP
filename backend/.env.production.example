# ============================================================
# ERP 后端生产环境配置模板（可提交，不得填写真实凭证）
# ============================================================
# 部署时复制为 .env 并填写实际值

# 服务端口
PORT=3001
NODE_ENV=production

# ERP 数据库（MySQL）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=erp_db
DB_USER=erp_user
DB_PASSWORD=<生产密码>

# 独立只读备份账号；不得拥有 INSERT/UPDATE/DELETE/CREATE/DROP/ALTER/INDEX 权限
DB_BACKUP_HOST=127.0.0.1
DB_BACKUP_PORT=3306
DB_BACKUP_NAME=erp_db
DB_BACKUP_USER=erp_backup_readonly
DB_BACKUP_PASSWORD=
BACKUP_DIR=/var/backups/erp
BACKUP_LOCK_FILE=/var/backups/erp/.backup.lock
KEEP_DAYS=30
# 仅维护窗口临时改为 YES；镜像必须预拉取并固定 digest
ALLOW_DB_RESTORE_SMOKE=NO
DB_RESTORE_ARTIFACT_SOURCE=local
DB_RESTORE_RECEIPT_PATH=
DB_RESTORE_MYSQL_IMAGE=
DB_RESTORE_COMMAND_TIMEOUT_MS=300000
READY_REQUIRED_CONSECUTIVE_SUCCESSES=3
# 仅远端灾备演练临时注入；不得复用 COS_BACKUP_SECRET_ID/SECRET_KEY
COS_BACKUP_RESTORE_SECRET_ID=
COS_BACKUP_RESTORE_SECRET_KEY=
COS_BACKUP_RESTORE_SECURITY_TOKEN=

# 主项目数据库（仅旧密码登录/legacy 会话使用；统一 SSO 稳定后不再连接）
MAIN_DB_HOST=127.0.0.1
MAIN_DB_PORT=3306
MAIN_DB_NAME=patent_notice_system
MAIN_DB_USER=erp_readonly
MAIN_DB_PASSWORD=<只读密码>

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=<Redis密码>
REDIS_DB=2

# 旧版共享 JWT（仅灰度/回滚使用；不得与 ERP_SESSION_SECRET 相同）
JWT_SECRET=<与主项目相同的JWT密钥>
JWT_EXPIRES_IN=7d

# ============================================================
# 统一权限与 R7 SSO（生产部署前必须逐项回填）
# ============================================================
ENABLE_PASSWORD_LOGIN=true
ENABLE_SSO_LOGIN=false
ENABLE_LEGACY_SESSION=true

# 部署脚本会强制开启两项实连检查；这里也保持显式配置
UNIFIED_AUTH_PREFLIGHT_CHECK_DB=true
UNIFIED_AUTH_PREFLIGHT_CHECK_REDIS=true

# 主项目浏览器地址与内部 API 地址可能不同，按主项目回填值配置
MAIN_SYSTEM_URL=https://iptt.top
MAIN_SSO_BASE_URL=
MAIN_SSO_EXCHANGE_PATH=/api/v1/internal/sso/erp/exchange
MAIN_SSO_TEAM_SCOPE_PATH=/api/v1/internal/users/:userId/team-scope
MAIN_PERMISSION_VERSION_PATH=/api/v1/internal/users/:userId/permission-version
MAIN_SSO_CONTINUE_PATH=/sso/continue
MAIN_SSO_TIMEOUT_MS=5000
MAIN_USER_SCOPE_CACHE_TTL_MS=120000
MAIN_PERMISSION_VERSION_CACHE_TTL_MS=120000

# ERP RP state 与固定 callback
ERP_SSO_CALLBACK_URL_PRODUCTION=https://erp.iptt.top/sso/callback
ERP_SSO_STATE_TTL_SEC=120
ERP_SSO_STATE_COOKIE_NAME=erp_sso_browser
ERP_SSO_STATE_COOKIE_SECURE=true

# SSO exchange 独立凭证；Client ID/Secret 由主项目通过受控渠道交付
ERP_SSO_CLIENT_ID=
ERP_SSO_CLIENT_SECRET=
ERP_SSO_AUDIENCE=erp
ERP_SSO_ISSUER=patent-notice-system
ERP_SSO_ASSERTION_MAX_LIFETIME_SEC=120

# RS256 active/previous 双公钥；私钥只能保存在主项目受控环境
ERP_SSO_ACTIVE_KID=
ERP_SSO_ACTIVE_PUBLIC_KEY_PATH=
ERP_SSO_PREVIOUS_KID=
ERP_SSO_PREVIOUS_PUBLIC_KEY_PATH=
ERP_SSO_ALLOW_LEGACY_NO_KID=false

# ERP 独立短会话密钥，必须由密码管理器生成，不得复用 JWT_SECRET
ERP_SESSION_SECRET=
ERP_SESSION_EXPIRES_IN=2h

# ERP 调用主项目业务 API 的独立凭证
MAIN_API_CLIENT_ID=
MAIN_API_CLIENT_SECRET=

# 主项目契约 smoke；Code/state 只在一次真实 exchange smoke 时成对临时设置
MAIN_CONTRACT_SMOKE_USER_ID=
SSO_AUTHORIZATION_CODE=
SSO_STATE=

# 主项目权限中心拉取 ERP Manifest 的独立入站凭证
ERP_MANIFEST_CLIENT_ID=
ERP_MANIFEST_CLIENT_SECRET=

# 主项目调用 ERP Employee provisioning 的独立入站凭证
ERP_PROVISION_CLIENT_ID=
ERP_PROVISION_CLIENT_SECRET=
ERP_PROVISION_CLIENT_ID_HEADER=X-Main-Provision-Client-Id
ERP_PROVISION_CLIENT_SECRET_HEADER=X-Main-Provision-Client-Secret

# ERP 调用主项目专利业务接口；默认复用 MAIN_API 凭证但不复用 SSO 凭证
IP_AUTH_MODE=client_credentials
IP_API_BASE_URL=
IP_API_CLIENT_ID=
IP_API_CLIENT_SECRET=
IP_API_CLIENT_ID_HEADER=X-ERP-Service-Id
IP_API_CLIENT_SECRET_HEADER=X-ERP-Service-Secret
IP_API_ACTING_USER_ID_HEADER=X-Acting-User-Id
IP_API_PERMISSION_VERSION_HEADER=X-Acting-Permission-Version
IP_API_JOB_NAME_HEADER=X-ERP-Job-Name

# 浏览器只允许 ERP 生产域名
CORS_ORIGIN=https://erp.iptt.top

# 企业微信
WECHAT_CORP_ID=wwed291a8364287ea4
WECHAT_AGENT_ID=1000005
WECHAT_SECRET=
WECHAT_TOKEN=<部署后在企微管理后台设置>
WECHAT_AES_KEY=<部署后在企微管理后台设置>
WECHAT_APPROVAL_TEMPLATE_ID=

# 企微审批模板映射；旧 WECHAT_APPROVAL_TEMPLATE_ID 不再参与动态分发
WECHAT_TEMPLATE_CONTRACT=C4NvsAEvbP3Hdue6QrZC5Aa9MSejNkjnyrJRskC1N
WECHAT_TEMPLATE_PAYMENT=
WECHAT_TEMPLATE_EXPENSE=
WECHAT_TEMPLATE_LOAN=
# 生产环境必须显式配置；未经业务负责人书面批准不得改为 allow_unowned
WECHAT_UNBOUND_APPROVAL_POLICY=reject
WECHAT_EXPENSE_FIELD_AMOUNT=报销金额,报销总金额,总金额,费用金额,金额
WECHAT_EXPENSE_FIELD_DATE=费用发生日期,报销日期,发生日期,申请日期
WECHAT_EXPENSE_FIELD_SUMMARY=报销事由,费用说明,报销说明,事由,用途
WECHAT_EXPENSE_FIELD_CATEGORY=费用类型,报销类型,费用类别,报销类别
WECHAT_EXPENSE_FIELD_ACCOUNT=付款账户,支付账户,报销账户,付款方式

# 腾讯云 COS 业务桶；真实凭证只写入服务器 .env 或密钥管理系统
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=

# 数据库备份必须使用独立备份桶和最小权限凭证，不得复用上面的业务桶
COS_BACKUP_SECRET_ID=
COS_BACKUP_SECRET_KEY=
COS_BACKUP_BUCKET=
COS_BACKUP_REGION=

# 独立 COS 测试桶回环验证（不得复用业务桶或业务桶凭证）
# 桶名必须包含 test/ci/sandbox/smoke；建议使用短期、仅限单桶对象读写删权限的凭证。
# 非验证时保持为空；普通 CI 不运行真实 COS 请求。
COS_SMOKE_SECRET_ID=
COS_SMOKE_SECRET_KEY=
COS_SMOKE_SECURITY_TOKEN=
COS_SMOKE_BUCKET=
COS_SMOKE_REGION=
COS_SMOKE_TIMEOUT_MS=15000

# 日志
LOG_LEVEL=info
LOG_DIR=./logs
