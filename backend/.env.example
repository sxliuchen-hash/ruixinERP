# 服务配置
PORT=3001
NODE_ENV=development

# ERP 数据库
DB_HOST=localhost
DB_PORT=3306
DB_NAME=erp_db
DB_USER=root
DB_PASSWORD=your_password_here

# 数据库备份必须使用独立只读账号，不得复用应用 DB_USER/DB_PASSWORD
DB_BACKUP_HOST=localhost
DB_BACKUP_PORT=3306
DB_BACKUP_NAME=erp_db
DB_BACKUP_USER=erp_backup_readonly
DB_BACKUP_PASSWORD=
BACKUP_DIR=/tmp/erp_backups
BACKUP_LOCK_FILE=/tmp/erp_backups/.backup.lock
KEEP_DAYS=30
# 恢复 smoke 只接受固定 digest 镜像；真实值由运维在受控环境回填
ALLOW_DB_RESTORE_SMOKE=NO
DB_RESTORE_ARTIFACT_SOURCE=local
DB_RESTORE_RECEIPT_PATH=
DB_RESTORE_MYSQL_IMAGE=
DB_RESTORE_COMMAND_TIMEOUT_MS=300000
# 仅 DB_RESTORE_ARTIFACT_SOURCE=cos 时配置；必须是独立只读 GetObject 凭证
COS_BACKUP_RESTORE_SECRET_ID=
COS_BACKUP_RESTORE_SECRET_KEY=
COS_BACKUP_RESTORE_SECURITY_TOKEN=

# 主项目数据库（仅旧密码登录/legacy 会话使用；两项开关均关闭后不会连接）
MAIN_DB_HOST=localhost
MAIN_DB_PORT=3306
MAIN_DB_NAME=patent_notice_system
MAIN_DB_USER=root
MAIN_DB_PASSWORD=your_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# 生产统一认证预检必须主动 PING Redis，客户端会在检查后关闭，不保留开放句柄
UNIFIED_AUTH_PREFLIGHT_CHECK_REDIS=true

# 旧版共享 JWT（仅密码登录/legacy 回滚使用；全量 SSO 可不配置）
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# 登录方式开关（上线初期保持旧密码登录可用，主项目联调完成后再切换）
ENABLE_PASSWORD_LOGIN=true
ENABLE_SSO_LOGIN=false
# 关闭密码登录后可先保留旧会话；稳定后设为 false 使历史 7d JWT 立即失效
ENABLE_LEGACY_SESSION=true
# ERP 登录页“返回主项目”固定地址；不要配置内部 API 地址
MAIN_SYSTEM_URL=https://iptt.top

# 统一认证生产配置预检默认不连接数据库；显式 true 时只读检查 employees.user_id 唯一索引
UNIFIED_AUTH_PREFLIGHT_CHECK_DB=false

# 主项目 SSO：ERP 使用一次性 code 调用主项目服务端兑换接口；契约 smoke 命令要求显式配置该地址
MAIN_SSO_BASE_URL=http://127.0.0.1:3000
MAIN_SSO_EXCHANGE_PATH=/api/v1/internal/sso/erp/exchange
MAIN_SSO_TEAM_SCOPE_PATH=/api/v1/internal/users/:userId/team-scope
MAIN_PERMISSION_VERSION_PATH=/api/v1/internal/users/:userId/permission-version
MAIN_SSO_TIMEOUT_MS=5000
MAIN_USER_SCOPE_CACHE_TTL_MS=120000
MAIN_PERMISSION_VERSION_CACHE_TTL_MS=120000
# 一次性 Code 必须绑定部署环境固定回调地址；生产环境请使用 HTTPS
ERP_SSO_CALLBACK_URL_TEST=http://localhost:5173/sso/callback
ERP_SSO_CALLBACK_URL_PRODUCTION=https://erp.iptt.top/sso/callback
MAIN_SSO_CONTINUE_PATH=/sso/continue
ERP_SSO_STATE_TTL_SEC=120
ERP_SSO_STATE_COOKIE_NAME=erp_sso_browser
# 本地 HTTP 开发可为 false；生产环境代码会强制使用 Secure Cookie
ERP_SSO_STATE_COOKIE_SECURE=false
ERP_SSO_CLIENT_ID=erp
ERP_SSO_CLIENT_SECRET=replace_with_service_secret
ERP_SSO_AUDIENCE=erp
ERP_SSO_ISSUER=patent-notice-system
# ERP 拒绝超长 assertion；主项目当前默认 90 秒，ERP 上限建议保持 120 秒
ERP_SSO_ASSERTION_MAX_LIFETIME_SEC=120
# assertion 使用 RS256 + kid；active/previous 双公钥支持无中断轮换
ERP_SSO_ACTIVE_KID=main-2026-01
ERP_SSO_ACTIVE_PUBLIC_KEY=
ERP_SSO_ACTIVE_PUBLIC_KEY_PATH=./keys/main-erp-active-public.pem
ERP_SSO_PREVIOUS_KID=main-2025-12
ERP_SSO_PREVIOUS_PUBLIC_KEY=
ERP_SSO_PREVIOUS_PUBLIC_KEY_PATH=
# 仅旧联调环境可临时兼容无 kid 的单公钥 assertion，正式环境保持 false
ERP_SSO_ALLOW_LEGACY_NO_KID=false
# SSO 会话使用独立密钥；未配置时仅为兼容旧部署才回退 JWT_SECRET
ERP_SESSION_SECRET=replace_with_independent_session_secret
ERP_SESSION_EXPIRES_IN=2h

# ERP 调用主项目业务 API（团队范围/权限版本）的独立凭证，不得复用 SSO code 兑换凭证
MAIN_API_CLIENT_ID=erp-business-api
MAIN_API_CLIENT_SECRET=replace_with_business_api_secret

# 主项目测试环境契约烟雾检查；用户 ID 必填，一次性 Code/state 必须成对配置且运行后会被消费
MAIN_CONTRACT_SMOKE_USER_ID=
SSO_AUTHORIZATION_CODE=
SSO_STATE=

# 主项目权限中心拉取 ERP Manifest 的入站服务凭证
ERP_MANIFEST_CLIENT_ID=main-permission-center
ERP_MANIFEST_CLIENT_SECRET=replace_with_manifest_secret

# 主项目绑定 ERP 账号时调用 Employee 建档接口的独立入站凭证
# POST /api/v1/internal/provisioning/employees
ERP_PROVISION_CLIENT_ID=main-employee-provision
ERP_PROVISION_CLIENT_SECRET=replace_with_provision_secret
ERP_PROVISION_CLIENT_ID_HEADER=X-Main-Provision-Client-Id
ERP_PROVISION_CLIENT_SECRET_HEADER=X-Main-Provision-Client-Secret

# 日志
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:5173

# 企业微信
# CorpID：企业信息页底部获取
WECHAT_CORP_ID=your_corp_id_here
# AgentID：审批应用详情页底部
WECHAT_AGENT_ID=
# Secret：审批应用详情页查看（43 位）
WECHAT_SECRET=
# 回调 Token：自定义字符串（部署后在企微后台配置回调时设置）
WECHAT_TOKEN=
# EncodingAESKey：43 位，企微后台随机生成
WECHAT_AES_KEY=

# 企业微信审批模板映射（T10 使用，按需填入）
# 合同审批模板 ID
WECHAT_TEMPLATE_CONTRACT=
# 报销模板 ID
WECHAT_TEMPLATE_EXPENSE=
# 借款模板 ID（当前仅展示配置状态，后端同步明确 unsupported，不会写入借款单）
WECHAT_TEMPLATE_LOAN=
# 付款申请模板 ID
WECHAT_TEMPLATE_PAYMENT=

# 企微合同/付款/报销申请人未绑定主账号时的统一策略；默认及建议值均为 reject
# allow_unowned 仅可在业务负责人明确批准并完成数据库迁移后临时启用
WECHAT_UNBOUND_APPROVAL_POLICY=reject

# 报销模板字段标题别名，按逗号分隔；应与企微模板中的中文字段标题一致
WECHAT_EXPENSE_FIELD_AMOUNT=报销金额,报销总金额,总金额,费用金额,金额
WECHAT_EXPENSE_FIELD_DATE=费用发生日期,报销日期,发生日期,申请日期
WECHAT_EXPENSE_FIELD_SUMMARY=报销事由,费用说明,报销说明,事由,用途
WECHAT_EXPENSE_FIELD_CATEGORY=费用类型,报销类型,费用类别,报销类别
WECHAT_EXPENSE_FIELD_ACCOUNT=付款账户,支付账户,报销账户,付款方式

# IP 系统（知识产权官文管理系统）
IP_API_BASE_URL=http://127.0.0.1:3000/api/v1
# 目标模式：独立服务凭证 + acting user
# 灰度期如需同时承接 legacy 和 main_sso 会话，使用 hybrid；旧会话排空后切回 client_credentials
# legacy_shared_jwt 只作为全量旧认证的应急回滚模式
IP_AUTH_MODE=client_credentials
# 不填时复用 MAIN_API_CLIENT_ID / MAIN_API_CLIENT_SECRET（仍与 SSO 凭证分离）
IP_API_CLIENT_ID=
IP_API_CLIENT_SECRET=
IP_API_CLIENT_ID_HEADER=X-ERP-Service-Id
IP_API_CLIENT_SECRET_HEADER=X-ERP-Service-Secret
IP_API_ACTING_USER_ID_HEADER=X-Acting-User-Id
IP_API_PERMISSION_VERSION_HEADER=X-Acting-Permission-Version
IP_API_JOB_NAME_HEADER=X-ERP-Job-Name
# 仅 legacy_shared_jwt 回滚模式使用
IP_SYSTEM_USER_ID=1

# 腾讯云 COS
COS_SECRET_ID=your_secret_id
COS_SECRET_KEY=your_secret_key
COS_BUCKET=your_bucket
COS_REGION=ap-guangzhou

# 数据库备份使用独立 COS 桶与最小权限凭证，不得复用业务 COS_BUCKET/凭证
COS_BACKUP_SECRET_ID=
COS_BACKUP_SECRET_KEY=
COS_BACKUP_BUCKET=
COS_BACKUP_REGION=

# COS 单对象 round-trip smoke（只允许独立测试桶和最小权限临时凭证）
# 测试桶名必须包含 test/ci/sandbox/smoke，且不得与 COS_BUCKET 相同。
# 仅在人工或受保护的 workflow_dispatch 中临时回填；普通 CI 不运行真实请求。
COS_SMOKE_SECRET_ID=
COS_SMOKE_SECRET_KEY=
COS_SMOKE_SECURITY_TOKEN=
COS_SMOKE_BUCKET=
COS_SMOKE_REGION=
COS_SMOKE_TIMEOUT_MS=15000
